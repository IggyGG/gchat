{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GChat",
  "version": "0.1.4",
  "identifier": "dev.ghost.gchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GChat",
        "width": 1100,
        "height": 720,
        "minWidth": 320,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "android": {
      "minSdkVersion": 26,
      "versionCode": 1005
    },
    "license": "MIT OR Apache-2.0",
    "resources": {
      "../../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../../LICENSE-APACHE": "licenses/LICENSE-APACHE",
      "../../../NOTICE.md": "licenses/NOTICE.md",
      "../../../third-party/LICENSE-webpki-roots": "licenses/LICENSE-webpki-roots",
      "../public/fonts/LICENSE-CC0": "licenses/LICENSE-CC0",
      "../../../third-party/generated/": "licenses/dependencies/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "Secure communication over GComs",
    "longDescription": "GChat provides encrypted conversations with invitation-based access and signed relay defaults.",
    "publisher": "Gh0st"
  }
}
