#!/usr/bin/env python3
import os,subprocess,sys
from pathlib import Path
home=Path(os.environ['GNUPGHOME']);home.mkdir(mode=0o700,exist_ok=True);home.chmod(0o700)
# The runtime imports only its configured release key from a read-only secret.
subprocess.run(['gpg','--batch','--import','/keys/linux-private.asc'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
os.execv(sys.executable,[sys.executable,'/opt/gchat/scripts/release_coordinator.py',*sys.argv[1:]])
