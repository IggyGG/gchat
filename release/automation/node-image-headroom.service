[Unit]
Description=Maintain GChat node image-cache headroom
ConditionPathExists=/run/containerd/containerd.sock

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/gchat-node-image-headroom.py
TimeoutStartSec=150
StateDirectory=gchat-node-image-headroom
StateDirectoryMode=0700
RuntimeDirectory=gchat-node-image-headroom
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/gchat-node-image-headroom /run/gchat-node-image-headroom
