#!/usr/bin/env python3
"""Initialize a signed, empty GChat repository; never publish an application."""
import datetime,email.utils,gzip,json,os,subprocess,sys
from pathlib import Path
sys.path.insert(0,'/opt/gchat/scripts')
from release_feed import digest
from release_signatures import verify
config=json.loads(Path('/config/publisher.json').read_text())
root=Path(config['public_root'])/'apt';stable=root/'dists/stable'
if stable.exists():raise SystemExit('APT already initialized; preserving its current release')
snapshot=root/'snapshots/bootstrap';binary=snapshot/'main/binary-amd64';binary.mkdir(parents=True,exist_ok=True)
(root/'pool').mkdir(exist_ok=True)
(binary/'Packages').write_bytes(b'');(binary/'Packages.gz').write_bytes(gzip.compress(b'',mtime=0))
now=datetime.datetime.now(datetime.timezone.utc)
release=('Origin: GChat\nLabel: GChat\nSuite: stable\nCodename: stable\nArchitectures: amd64\nComponents: main\nAcquire-By-Hash: yes\n'
         +'Date: '+email.utils.format_datetime(now,usegmt=True)+'\nValid-Until: '+email.utils.format_datetime(now+datetime.timedelta(days=14),usegmt=True)+'\nSHA256:\n')
for path in (binary/'Packages',binary/'Packages.gz'):
 sha=digest(path);release+=f' {sha} {path.stat().st_size} {path.relative_to(snapshot).as_posix()}\n'
 link=binary/'by-hash/SHA256'/sha;link.parent.mkdir(parents=True,exist_ok=True)
 if not link.exists():os.link(path,link)
(snapshot/'Release').write_text(release)
for flags,destination in [(['--clearsign'],'InRelease'),(['--armor','--detach-sign'],'Release.gpg')]:
 subprocess.run(['gpg','--batch','--yes','--pinentry-mode','loopback','--passphrase-file',os.environ['GCHAT_RELEASE_PASSPHRASE_FILE'],'--local-user',config['gpg_key'],*flags,'--output',str(snapshot/destination),str(snapshot/'Release')],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE)
verify(snapshot/'Release.gpg',snapshot/'Release',config['gpg_key'])
stable.parent.mkdir(exist_ok=True);stable.symlink_to('../snapshots/bootstrap')
print('Signed empty APT repository initialized; no application release advertised.')
